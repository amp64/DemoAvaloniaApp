<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-ios26.5;net10.0-ios</TargetFrameworks>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <XSAppIconAssets>Assets.xcassets/AppIcon.appiconset</XSAppIconAssets>
    <Configurations>Debug;Release;Store Release</Configurations>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <Import Project="LocalOverrides.props"
          Condition="Exists('LocalOverrides.props')" />

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CreatePackage>false</CreatePackage>
    <CodesignKey>iPhone Developer</CodesignKey>
    <MtouchLink>SdkOnly</MtouchLink>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <CreatePackage>false</CreatePackage>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Store Release'">
    <CreatePackage>false</CreatePackage>
    <MTouchExtraArgs>--abi=arm64</MTouchExtraArgs>
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <Optimize>true</Optimize>
    <TrimMode>partial</TrimMode>
    <MtouchLink>Full</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <ImageAsset Include="Assets.xcassets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReproApp\ReproApp.csproj" />
  </ItemGroup>
</Project>
